{
  "name": "dragon-presentation-generator",
  "version": "0.1.0",
  "description": "A keyboard-driven, offline-first presentation engine. Your talk is typed data; the stage layer never knows what it is about.",
  "scripts": {
    "dev": "vite",
    "build": "node check-themes.mjs && tsc -b && vite build",
    "check:themes": "node check-themes.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "export:pdf": "node export-pdf.mjs",
    "verify": "node verify.mjs"
  },
  "keywords": [
    "presentation",
    "slides",
    "deck",
    "react",
    "offline",
    "keyboard"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true,
  "type": "module"
}
